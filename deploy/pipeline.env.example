# Copie para /etc/painel/pipeline.env no servidor (dono root, modo 600). Lido pelas unidades painel-ingest*.
# Sem PAINEL_MAIL_TO e PAINEL_SMTP_HOST, o pipeline roda normalmente e registra tudo em data/status/, mas não avisa.

# Destinatários, separados por vírgula.
PAINEL_MAIL_TO=voce@exemplo.com.br
# Remetente (padrão: o usuário SMTP ou o primeiro destinatário).
PAINEL_MAIL_FROM=painel@exemplo.com.br
# Servidor SMTP. Exemplos: smtp.gmail.com (587, starttls, senha de app); smtp.resend.com; smtp-relay.brevo.com.
PAINEL_SMTP_HOST=smtp.gmail.com
PAINEL_SMTP_PORT=587
# starttls (porta 587), ssl (porta 465) ou none.
PAINEL_SMTP_SECURITY=starttls
PAINEL_SMTP_USER=voce@gmail.com
PAINEL_SMTP_PASSWORD=senha-de-app
# 1 para receber também o resumo das execuções bem-sucedidas (padrão: só falhas e parciais).
PAINEL_MAIL_ON_SUCCESS=0
# Opcional: URL de ping de um monitor externo (ex.: healthchecks.io). Avisa quando o job deixa de rodar.
# Sucesso faz GET na URL; falha faz GET em URL/fail.
#PAINEL_HEALTHCHECK_URL=https://hc-ping.com/uuid
